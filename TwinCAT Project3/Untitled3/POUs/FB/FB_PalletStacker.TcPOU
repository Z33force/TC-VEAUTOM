<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_PalletStacker" Id="{f45694bc-ba92-48cf-a251-5a58335c5f47}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PalletStacker IMPLEMENTS ITFGesimuleerdAO, ITFPalletStacker
VAR_INPUT
END_VAR
VAR_OUTPUT
	PalletError :bool := 0;
END_VAR

VAR CONSTANT
	MaxPallet : UINT := 5;
	pallethoogte : UINT := 20;
	platformhoogte : UINT := 0;
	MaxPalletSensor : UINT:= (maxpallet * pallethoogte + platformhoogte);
END_VAR

VAR
	StateBeforeError : E_PalletStackerStatus;
	LegenDone        : BOOL;

	DoorClosed           : BOOL;  // Safety door switch (TRUE = closed/safe)
	DoorLockEnable       : BOOL;  // Output to lock door (TRUE = lock)
	DoorOpenAllowed      : BOOL;  // HMI indicator
	
	LegenCmd             : BOOL;  // HMI request to empty
	LegenConfirmed       : BOOL;  // HMI confirmation after emptying
	StartCmd             : BOOL;  // HMI start cycle
	StopCmd              : BOOL;  // HMI stop cycle
	
	CycleActive          : BOOL;  // internal running flag
	ClearForLoad         : BOOL;  // internal gating
	
	liftTol              : REAL;  // position tolerance

	Loopband : FB_temploopband;
    Pins     : FB_temppalletpins;
    Lift     : FB_servomotor;
    AfstandSensor  : FB_AfstandSensor;
	PalletBufferSensor : FB_LichtSensor;
	PalletInLiftSensor : FB_lichtSensor;

    State    : E_PalletStackerStatus := E_PalletStackerStatus.Idle;
	StateString : string;
    Faulted  : BOOL;
	
	EBufferStatus : E_BufferStatus := 0;
	
	PinsTerugmelding: BOOL ;
	temp: BOOL;
	temp2: BOOL;
	NextStep :STRING;
	ERROR: BOOL;
	ReadyForNext: BOOL := 1;
	
	ErrorTimer: TON;
	
	HMIETTIMER: TIME;
	AlarmAck: BOOL;
	AlarmTrig: BOOL;
	PalletLoadedBeforeLift: BOOL;
	buffervolstring: STRING;
	StateChanged: BOOL;
	StatePrev: E_PalletStackerStatus;
END_VAR

//note
//Fucntie's moeten demo functietjes worden
// to be tested
// lift logica kan ik al regelen en de basis functionaliteit
// toevoegen van errors, alarms, en safety]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Update bufferstatus
statestring := TO_STRING(state);
buffervolstring := TO_STRING(EBufferStatus);
HMIETTIMER := ErrorTimer.ET;

// Detect state change for timer reset
StateChanged := (State <> StatePrev);
IF StateChanged THEN
    StatePrev := State;
    AlarmTrig := FALSE;
END_IF

// Door handling (safety interlock)
IF NOT DoorClosed THEN
    // Pause everything while door open
    Loopband.Stop();
    lift.Enable := 0;
    AlarmTrig := FALSE;
    // Do not change State while paused
ELSE
    lift.Enable := 1;
END_IF

// ErrorTimer handling (reset on state change or door open)
IF StateChanged OR NOT AlarmTrig OR NOT DoorClosed THEN
    ErrorTimer(IN := FALSE, PT := T#60S);
ELSE
    ErrorTimer(IN := TRUE, PT := T#60S);
END_IF

IF ErrorTimer.Q AND State <> E_PalletStackerStatus.Error THEN
    StateBeforeError := State;
    State := E_PalletStackerStatus.Error;
    AlarmTrig := FALSE;
END_IF

// Bufferstatus bepalen
IF AfstandSensor.SensorWaarde >= MaxPalletSensor THEN
    EBufferStatus := E_BufferStatus.vol;
ELSIF AfstandSensor.SensorWaarde = MaxPalletSensor - 2 * pallethoogte
      AND MaxPalletSensor > 2 * pallethoogte + platformhoogte THEN
    EBufferStatus := E_BufferStatus.BijnaVol;
ELSIF AfstandSensor.SensorWaarde >= platformhoogte + pallethoogte THEN
    EBufferStatus := E_BufferStatus.DeelsGevuld;
ELSE
    EBufferStatus := E_BufferStatus.Leeg;
END_IF

// Clear to load condition: no pins out, lift at load height, not mid-cycle
ClearForLoad :=
    (NOT pins.PinsUit)
    AND (ABS(lift.positie - (platformhoogte + pallethoogte)) <= liftTol)
    AND (NOT PalletLoadedBeforeLift);

// Door lock logic
IF State = E_PalletStackerStatus.Legen THEN
    IF LegenDone THEN
        DoorLockEnable := FALSE; // door open allowed after emptying done
    ELSE
        DoorLockEnable := TRUE;  // lock during movement
    END_IF
ELSIF CycleActive THEN
    DoorLockEnable := TRUE;
ELSE
    DoorLockEnable := FALSE;
END_IF

DoorOpenAllowed := NOT DoorLockEnable;

// Start/Stop behavior
IF StopCmd THEN
    CycleActive := FALSE;
END_IF

IF StartCmd AND DoorClosed THEN
    CycleActive := TRUE;
END_IF

CASE State OF
//==================== Idle ====================
E_PalletStackerStatus.Idle:
    nextstep := 'Idle: wacht op start/legen';
    readyfornext := FALSE;
    PalletLoadedBeforeLift := 0;
    AlarmTrig := FALSE;
    LegenDone := FALSE;

    IF LegenCmd THEN
        State := E_PalletStackerStatus.Legen;
    ELSIF CycleActive THEN
        State := E_PalletStackerStatus.Collecting;
    END_IF

//==================== Collecting ====================
E_PalletStackerStatus.Collecting:
    nextstep := 'Collecting: pallet naar buffer';

    IF NOT DoorClosed THEN
        nextstep := 'Collecting: deur open, pauze';
        Loopband.Stop();
        AlarmTrig := FALSE;

    // 1) Breng pallet naar voor de lift
    ELSIF (EBufferStatus = E_BufferStatus.Leeg OR EBufferStatus = E_BufferStatus.DeelsGevuld)
          AND NOT PalletLoadedBeforeLift THEN

        Loopband.Beweeg();
        nextstep := 'Collecting: wacht op PalletBeforeLiftSensor';

        IF PalletBufferSensor.SensorWaarde1 THEN
            Loopband.Stop();
            PalletLoadedBeforeLift := 1;
            AlarmTrig := FALSE;
        ELSE
            AlarmTrig := TRUE;
        END_IF

    // 2) Zorg dat lift klaar is (geen pins uit, juiste hoogte)
    ELSIF PalletLoadedBeforeLift AND NOT readyfornext THEN
        IF NOT pins.pinsin THEN
            pins.ErinBewegen();
            nextstep := 'Collecting: pins in voor laden';
            AlarmTrig := TRUE;
        ELSE
            lift.DoelPositie := platformhoogte + pallethoogte;
            lift.BeweegNaarDoel();
            nextstep := 'Collecting: lift naar laadhoogte';

            IF ABS(lift.positie - (platformhoogte + pallethoogte)) <= liftTol THEN
                readyfornext := TRUE;
                AlarmTrig := FALSE;
            ELSE
                AlarmTrig := TRUE;
            END_IF
        END_IF

    // 3) Pallet in lift laden
    ELSIF readyfornext AND PalletLoadedBeforeLift THEN
        Loopband.Beweeg();
        nextstep := 'Collecting: wacht op PalletInLiftSensor';

        IF PalletInLiftSensor.SensorWaarde1 THEN
            readyfornext := FALSE;
            PalletLoadedBeforeLift := 0;
            Loopband.Stop();
            State := E_PalletStackerStatus.PinsUitBewegen;
            AlarmTrig := FALSE;
        ELSE
            AlarmTrig := TRUE;
        END_IF

    ELSE
        Loopband.Stop();
        nextstep := 'Collecting: buffer bezet of wacht';
        AlarmTrig := FALSE;
    END_IF

//==================== Pins Uit Bewegen ====================
E_PalletStackerStatus.PinsUitBewegen:
    nextstep := 'PinsUit: pallet neerzetten op pins';

    IF NOT DoorClosed THEN
        nextstep := 'PinsUit: deur open, pauze';
        AlarmTrig := FALSE;
    ELSIF pins.PinsUit THEN
        State := E_PalletStackerStatus.LiftBewegen;
        AlarmTrig := FALSE;
    ELSE
        pins.EruitBewegen();
        AlarmTrig := TRUE;
    END_IF

//==================== Lift Bewegen ====================
E_PalletStackerStatus.LiftBewegen:
    nextstep := 'LiftBewegen: lift omlaag';

    IF NOT DoorClosed THEN
        nextstep := 'LiftBewegen: deur open, pauze';
        AlarmTrig := FALSE;
    ELSIF pins.pinsuit THEN
        lift.DoelPositie := platformhoogte;
        lift.BeweegNaarDoel();

        IF ABS(lift.positie - platformhoogte) <= liftTol THEN
            State := E_PalletStackerStatus.PinsInBewegen;
            AlarmTrig := FALSE;
        ELSE
            AlarmTrig := TRUE;
        END_IF
    ELSE
        AlarmTrig := TRUE;
    END_IF

//==================== Pins In Bewegen ====================
E_PalletStackerStatus.PinsInBewegen:
    nextstep := 'PinsIn: pallet vrijgeven';

    IF NOT DoorClosed THEN
        nextstep := 'PinsIn: deur open, pauze';
        AlarmTrig := FALSE;
    ELSIF pins.pinsin THEN
        State := E_PalletStackerStatus.PalletLaden;
        AlarmTrig := FALSE;
    ELSE
        pins.ErinBewegen();
        AlarmTrig := TRUE;
    END_IF

//==================== Pallet Laden ====================
E_PalletStackerStatus.PalletLaden:
    nextstep := 'PalletLaden: lift omhoog klaar voor next';

    IF NOT DoorClosed THEN
        nextstep := 'PalletLaden: deur open, pauze';
        AlarmTrig := FALSE;
    ELSE
        lift.DoelPositie := platformhoogte + pallethoogte;
        lift.BeweegNaarDoel();

        IF ABS(lift.positie - (platformhoogte + pallethoogte)) <= liftTol THEN
            readyfornext := TRUE;
            CycleActive := FALSE; // single-run klaar
            State := E_PalletStackerStatus.Idle;
            AfstandSensor.SensorWaarde := AfstandSensor.SensorWaarde + pallethoogte;
            AlarmTrig := FALSE;
        ELSE
            AlarmTrig := TRUE;
        END_IF
    END_IF

//==================== Legen ====================
E_PalletStackerStatus.Legen:
    nextstep := 'Legen: pallets naar bodem';

    // Alleen pauzeren bij deur open als we nog bewegen
    IF (NOT DoorClosed) AND (NOT LegenDone) THEN
        nextstep := 'Legen: deur open, pauze beweging';
        Loopband.Stop();
        AlarmTrig := FALSE;
    ELSE
        IF NOT LegenDone THEN
            lift.DoelPositie := 0;
            lift.BeweegNaarDoel();
            nextstep := 'Legen: lift naar bodem, pins uit';

            IF ABS(lift.positie - 0) <= liftTol THEN
                pins.EruitBewegen();
                IF pins.PinsUit THEN
                    LegenDone := TRUE;
                    AlarmTrig := FALSE;
                ELSE
                    AlarmTrig := TRUE;
                END_IF
            ELSE
                AlarmTrig := TRUE;
            END_IF
        ELSE
            nextstep := 'Legen: leeg, wacht confirm (deur mag open)';
            AlarmTrig := FALSE;

            // Pas leeg teller na confirm en alleen als deur dicht
            IF LegenConfirmed AND DoorClosed THEN
                AfstandSensor.SensorWaarde := 0;
                LegenDone := FALSE;
                State := E_PalletStackerStatus.Idle;
            END_IF
        END_IF
    END_IF

//==================== Error ====================
E_PalletStackerStatus.Error:
    nextstep := 'ERROR: stop alles, wacht reset';
    ERROR := 1;

    Loopband.Stop();
    lift.Enable := 0;
    lift.DoelPositie := lift.positie;

    readyfornext := FALSE;
    PalletLoadedBeforeLift := 0;
    AlarmTrig := FALSE;
    CycleActive := FALSE;

    IF AlarmAck = 1 THEN
        ERROR := 0;
        AlarmTrig := FALSE;
        // Als deur dicht, ga terug naar waar je was, anders Idle
        IF DoorClosed THEN
            State := StateBeforeError;
        ELSE
            State := E_PalletStackerStatus.Idle;
        END_IF
    END_IF
END_CASE
]]></ST>
    </Implementation>
    <Method Name="CollectPallet" Id="{2e0f8c98-5db4-438b-8f55-10439f8e8dd0}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD CollectPallet : bool
]]></Declaration>
      <Implementation>
        <ST><![CDATA[    IF State = E_PalletStackerStatus.idle AND NOT afstandsensor.SensorWaarde >= MaxPalletSensor THEN
        State := E_PalletStackerStatus.Collecting;
        CollectPallet := TRUE;
    ELSE
        CollectPallet := FALSE;
    END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="EmptyStack" Id="{4fd40552-96ad-46df-a199-16395d9dac33}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD EmptyStack : bool
]]></Declaration>
      <Implementation>
        <ST><![CDATA[    IF State = E_PalletStackerStatus.Idle AND NOT afstandsensor.SensorWaarde >= MaxPallet THEN
        State := E_PalletStackerStatus.Legen;
        EmptyStack := TRUE;
    ELSE
        EmptyStack := FALSE;
    END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{c36c0b0e-cd8a-477d-a08b-6448acad0b78}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="SensorWaarde" Id="{52c28f07-420d-49f0-af6f-501886b94371}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY SensorWaarde : INT
]]></Declaration>
      <Get Name="Get" Id="{fcf33d1b-5a0c-4f37-b627-498eaa464cce}">
