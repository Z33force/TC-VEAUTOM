END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{23c68930-cb6e-4440-8a8f-ba7d9ea75f2a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="StackPallet" Id="{fa70ac83-9774-46ac-9ac1-602eca07dc85}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD StackPallet : bool
]]></Declaration>
      <Implementation>
        <ST><![CDATA[    IF State = E_PalletStackerStatus.Idle AND NOT afstandsensor.SensorWaarde >= MaxPallet THEN
       // State := E_PalletStackerStatus.PinsBewegen;
        StackPallet := TRUE;
    ELSE
        StackPallet := FALSE;
    END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Status" Id="{e14859b8-bdcb-46ee-90ab-2c453bb336ae}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY Status : E_DeviceStatus
]]></Declaration>
      <Get Name="Get" Id="{1b639bff-9b85-44a6-b411-2b7bb4d069d0}">
